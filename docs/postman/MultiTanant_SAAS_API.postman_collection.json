        {
          "name": "Authentication",
          "description": "Authentication and public tenant onboarding endpoints.",
          "item": [
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Login returns 200\", function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const json = pm.response.json();",
                      "if (json \u0026\u0026 json.accessToken) {",
                      "  pm.collectionVariables.set(\"ACCESS_TOKEN\", json.accessToken);",
                      "  console.log(\"ACCESS_TOKEN updated from login response.\");",
                      "} else {",
                      "  console.warn(\"No accessToken found in login response.\");",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "description": "Authenticates user credentials and stores JWT token into collection variable ACCESS_TOKEN automatically.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"{{PLATFORM_USERNAME}}\",\n  \"password\": \"{{PLATFORM_PASSWORD}}\"\n}",
                  "options": {
