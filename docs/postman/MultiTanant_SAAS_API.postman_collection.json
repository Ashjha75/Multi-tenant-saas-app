{
  "info": {
    "_postman_id": "d0f6d931-4cf0-4e89-bf37-31f9ea1ec8ea",
    "name": " Multi-Tenant SaaS API -  Collection",
    "description": "Professional Postman collection for demonstrating a JWT-secured, multi-tenant SaaS backend. Includes tenant lifecycle, user management, catalog, stock movements, and automation scripts for bearer token and tenant header injection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level automation",
          "// 1) Inject X-Tenant-ID from collection variable TENANT_ID",
          "// 2) Inject Authorization bearer token from ACCESS_TOKEN when available",
          "const tenantId = pm.collectionVariables.get(\"TENANT_ID\");",
          "if (tenantId) {",
          "  pm.request.headers.upsert({ key: \"X-Tenant-ID\", value: tenantId });",
          "}",
          "",
          "const token = pm.collectionVariables.get(\"ACCESS_TOKEN\");",
          "if (token) {",
          "  pm.request.headers.upsert({ key: \"Authorization\", value: `Bearer ${token}` });",
          "}"
        ]
      }
    }
  ],
