# Local environment variables for Spring Boot (development)
# If you run the app from IntelliJ on your host machine, keep DB_HOST=localhost.
# If you run the app inside Docker, set DB_HOST to the docker-compose service name (e.g. postgres).

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas-db
DB_USER=postgres
DB_PASSWORD=postgres

DB_TZ=Asia/Kolkata

TENANT_MODE=filter
