# ─────────────────────────────────────────────────────────────────────────
#  .env.example  —  Copy to .env and fill in REAL values before deploying.
#  The .env file is in .gitignore and is NEVER committed to the repository.
#
#  docker compose reads this file for BOTH container env vars and for the
#  ${...} placeholders inside docker-compose.yml, so every variable used
#  there must exist here.
# ─────────────────────────────────────────────────────────────────────────

# Spring Boot active profile
# Use "dev" locally, "prod" on a server (create application-prod.yaml if needed)
SPRING_PROFILES_ACTIVE=prod

# Port the app listens on.
# Host run  : the app binds this port directly.
# Compose   : this is the HOST port; inside the container the app always uses 8080.
SERVER_PORT=8080

# ── Database ─────────────────────────────────────────────────────────────
# DB_HOST/DB_PORT are overridden to "postgres"/5432 by docker-compose, but keep
# them here so local (non-Docker) runs still work with localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas-db
DB_USER=postgres
# ⚠️  Use a strong random password in production!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Postgres timezone (must be a valid tz identifier)
DB_TZ=Asia/Kolkata

# Tenant strategy: filter | schema
TENANT_MODE=filter

# ── JWT / RSA Keys ───────────────────────────────────────────────────────
# The value is resolved by Spring's ResourceLoader, so the "file:" prefix is
# required for filesystem paths. "./certs" is the project root on a host run
# and /app/certs inside the container, so one value works in both.
#
#   docker compose : the "keygen" service creates ./certs/*.pem on first start.
#   host run       : create the pair once with
#                      openssl genrsa -out certs/private_key.pem 2048
#                      openssl rsa -in certs/private_key.pem -pubout -out certs/public_key.pem
#   ECS / Fargate  : do NOT set these paths. Instead inject the key CONTENT as
#                    JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (PEM or base64) from
#                    Secrets Manager — the entrypoint writes them to /app/certs.
JWT_PRIVATE_KEY_PATH=file:./certs/private_key.pem
JWT_PUBLIC_KEY_PATH=file:./certs/public_key.pem

# Access-token lifetime in milliseconds (default 24 h)
JWT_ACCESS_TOKEN_EXPIRATION=86400000
