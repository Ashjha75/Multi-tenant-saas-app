# Copy this file to `.env` and adjust values for your machine.
# NOTE:
# - If your Spring Boot app runs on your host machine, DB_HOST is usually `localhost`.
# - If your Spring Boot app runs inside Docker on the same network as Postgres,
#   use the docker-compose service name (e.g. `postgres`) as DB_HOST.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas-db
DB_USER=postgres
DB_PASSWORD=postgres

# Postgres timezone (must be a valid Postgres timezone, e.g. Asia/Kolkata)
DB_TZ=Asia/Kolkata

# Tenant strategy: filter (current) or schema (future)
TENANT_MODE=filter
