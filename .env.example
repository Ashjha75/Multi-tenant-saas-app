# ─────────────────────────────────────────────────────────────────────────
#  .env.example  —  Copy to .env and fill in REAL values before deploying.
#  The .env file is in .gitignore and is NEVER committed to the repository.
# ─────────────────────────────────────────────────────────────────────────

# Spring Boot active profile
# Use "dev" locally, "prod" on VPS (create application-prod.yaml if needed)
SPRING_PROFILES_ACTIVE=prod

# Server port (the host port in docker-compose maps to this)
SERVER_PORT=8080

# ── Database ─────────────────────────────────────────────────────────────
# DB_HOST is always overridden to "postgres" by docker-compose, but keep
# it here so local (non-Docker) runs still work with localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas-db
DB_USER=postgres
# ⚠️  Use a strong random password in production!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Postgres timezone (must be a valid tz identifier)
DB_TZ=Asia/Kolkata

# Tenant strategy: filter | schema
TENANT_MODE=schema

# ── JWT / RSA Keys ───────────────────────────────────────────────────────
# These point to paths INSIDE the container (the certs/ dir is volume-mounted).
# Generate once on your VPS:
#   openssl genrsa -out certs/private_key.pem 2048
#   openssl rsa -in certs/private_key.pem -pubout -out certs/public_key.pem
JWT_PRIVATE_KEY_PATH=certs/private_key.pem
JWT_PUBLIC_KEY_PATH=certs/public_key.pem

# Access-token lifetime in milliseconds (default 24 h)
JWT_ACCESS_TOKEN_EXPIRATION=86400000
